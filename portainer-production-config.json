{
  "hospital-backend-prod-cloud": {
    "name": "hospital-backend-prod-cloud",
    "image": "hospital-backend-prod",
    "ports": {
      "8020": "8080"
    },
    "environment": {
      "QUARKUS_PROFILE": "prod",
      "QUARKUS_DATASOURCE_JDBC_URL": "jdbc:oracle:thin:@35.208.14.178:1523/XE",
      "QUARKUS_DATASOURCE_USERNAME": "C##HOSPITAL",
      "QUARKUS_DATASOURCE_PASSWORD": "hospital123",
      "QUARKUS_HTTP_CORS": "true",
      "QUARKUS_HTTP_CORS_ORIGINS": "http://34.61.228.49:8021,http://localhost:8021,http://localhost:5173,http://localhost:8080",
